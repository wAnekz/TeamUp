rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasCompletedProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileComplete == true;
    }

    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/moderators)
        && request.auth.uid in get(/databases/$(database)/documents/config/moderators).data.uids;
    }

    match /config/{docId} {
      allow read: if isModerator();
      allow write: if false; // console / Admin SDK only
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && !('contacts' in request.resource.data)
        && !('banned' in request.resource.data);
      allow update: if (isOwner(userId)
        && request.resource.data.uid == userId
        && !('email' in request.resource.data)
        // Bans are moderator-only: a banned student must not lift their own.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned'])
        // Contacts moved to private/contacts: they may be removed from the
        // public profile (migration) but never added or changed here.
        && (!('contacts' in request.resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['contacts'])))
        || (isModerator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'updatedAt']));
      allow delete: if false;
    }

    match /users/{userId}/private/{docId} {
      // private/contacts is also readable by the student's teammates —
      // `visibleTo` is maintained by functions/src/contacts.ts only.
      allow read: if isOwner(userId)
        || (docId == 'contacts' && isSignedIn() && request.auth.uid in resource.data.get('visibleTo', []));
      // private/telegram is written by the bot webhook (Admin SDK) only.
      // The owner may disconnect (chatId → null) or toggle the digest, but
      // never point it at a chat id of their choosing — that would let
      // someone aim the bot's messages at another person's chat.
      allow create: if isOwner(userId) && docId != 'telegram'
        && (docId != 'contacts' || request.resource.data.keys().hasOnly(['contacts']));
      allow update: if isOwner(userId)
        && (docId != 'contacts' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts']))
        && (docId != 'telegram'
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatId', 'digest'])
                && (request.resource.data.chatId == null || request.resource.data.chatId == resource.data.chatId)));
      allow delete: if false;
    }

    // ---------------- achievements (portfolio) ----------------
    // Public to signed-in users like the rest of the profile; files live in
    // Storage under achievements/{uid}/ (see storage.rules).
    match /users/{userId}/achievements/{achievementId} {
      function validAchievement() {
        let d = request.resource.data;
        return d.uid == userId
          && !('fromProjectId' in d) // team results are written by syncTeamResult only
          && d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && d.type in ['hackathon', 'olympiad', 'certificate', 'project', 'other']
          && (!('description' in d) || d.description == null || (d.description is string && d.description.size() <= 400))
          && (!('result' in d) || d.result == null || (d.result is string && d.result.size() <= 60));
      }
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && validAchievement();
      allow delete: if isOwner(userId);
    }

    // ---------------- blocks (self-serve mute, client-side only) ----------------
    // users/{uid}/blocks/{blockedUid} — lets a user hide another user's chat
    // messages from their own view without needing a moderator. This is
    // NOT a substitute for reporting: it only filters what the blocker sees
    // client-side (see useBlockedUsers.ts / TeamChat.tsx) — the blocked
    // user can still technically write to a shared chat they're a member
    // of, this doc just tells every client of the blocker's to hide them.
    // Only the owner can ever read or write their own block list.
    match /users/{userId}/blocks/{blockedUid} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && blockedUid != userId;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // ---------------- schools directory ----------------
    // Public list behind the SchoolPicker. Students can add a missing school
    // (never marked verified, never overwrite an existing id — ids are
    // derived from name + city, which is what dedupes simultaneous adds).
    // Renames/merges are moderator-only.
    match /schools/{schoolId} {
      allow read: if true;
      // isSignedIn, not hasCompletedProfile: the picker is used *during*
      // profile completion, before profileComplete is true.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.keys().hasOnly(['name', 'city', 'key', 'aliases', 'verified', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100
        && (request.resource.data.city == null || (request.resource.data.city is string && request.resource.data.city.size() <= 60))
        && request.resource.data.aliases.size() == 0;
      allow update, delete: if isModerator();
    }

    // ---------------- publicProjects (guest view) ----------------
    // Anonymized mirror of published projects, written by the
    // syncPublicProject function — no names, avatars or member ids, so
    // signed-out visitors can browse without seeing anyone's identity
    // (the privacy policy limits profiles to registered users).
    match /publicProjects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------- projects ----------------
    match /projects/{projectId} {
      allow read: if isSignedIn();

      allow create: if hasCompletedProfile()
        && isEmailVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['open', 'closed', 'archived']
        // Teammates gain access to each other's contacts (functions/src/contacts.ts),
        // so a team starts empty and grows only through accepted applications.
        && request.resource.data.get('members', []).size() == 0;

      allow update: if (isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
          && isValidTeamChange())
        || isViewCountIncrement();
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      // members may stay the same, shrink (owner removes someone), or grow by
      // exactly one student whose application to this project is accepted in
      // the same transaction (useReviewApplication passes its id as
      // acceptedApplicationId). Invite-link joins go through joinByInvite.
      function isValidTeamChange() {
        let before = resource.data.get('members', []);
        let after = request.resource.data.get('members', []);
        return before.toSet().hasAll(after.toSet()) || isAcceptedJoin(before, after);
      }

      function isAcceptedJoin(before, after) {
        let appId = request.resource.data.get('acceptedApplicationId', '');
        let appPath = /databases/$(database)/documents/applications/$(appId);
        return appId is string && appId.size() > 0
          && after.size() == before.size() + 1
          && exists(appPath)
          && get(appPath).data.projectId == projectId
          && after.toSet().difference(before.toSet()) == [get(appPath).data.applicantId].toSet()
          && getAfter(appPath).data.status == 'accepted';
      }

      function isViewCountIncrement() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'updatedAt'])
          && request.resource.data.viewCount == resource.data.viewCount + 1;
      }

      match /messages/{messageId} {
        function project() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }
        function isTeamMember() {
          return isSignedIn()
            && (request.auth.uid == project().authorId
                || (('members' in project()) && request.auth.uid in project().members));
        }

        allow read: if isTeamMember();
        allow create: if isTeamMember()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.projectId == projectId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---------------- applications ----------------
    match /applications/{applicationId} {
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.applicantId == request.auth.uid
            || resource.data.ownerId == request.auth.uid);

      allow create: if hasCompletedProfile()
        && isEmailVerified()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.ownerId == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.authorId
        && !('viaInvite' in request.resource.data) // set only by joinByInvite
        && applicationId == request.resource.data.projectId + '_' + request.resource.data.roleId + '_' + request.resource.data.applicantId;

      // The project owner only decides; everything else on the application is fixed.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    // ---------------- lookingForTeam ----------------
    match /lookingForTeam/{postId} {
      allow read: if isSignedIn();
      allow create: if hasCompletedProfile() && isEmailVerified() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data.authorId);
    }

    // ---------------- savedProjects (favorites) ----------------
    match /savedProjects/{savedId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && savedId == request.resource.data.uid + '_' + request.resource.data.projectId;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // ---------------- feedback (bug reports to the developer) ----------------
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update: if false;
      allow delete: if false;
    }

    // ---------------- events (curated hackathons/olympiads TeamUp promotes) ----------------
    match /events/{eventId} {
      // Public: events carry no personal data, and they're the main reason
      // a signed-out visitor would look around before registering.
      allow read: if true;
      allow create: if isModerator();
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // ---------------- eventSubscriptions ("I'm interested") ----------------
    // Readable by everyone signed in — it's the public "who's going" list.
    // remindersSent is written by sendEventReminders only.
    match /eventSubscriptions/{subId} {
      allow read: if isSignedIn();
      allow create: if hasCompletedProfile()
        && request.resource.data.uid == request.auth.uid
        && subId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'userName', 'userAvatarUrl', 'lookingForTeam', 'createdAt'])
        && request.resource.data.lookingForTeam is bool;
      allow update: if isOwner(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lookingForTeam'])
        && request.resource.data.lookingForTeam is bool;
      allow delete: if isOwner(resource.data.uid);
    }

    // ---------------- auto-collected event drafts ----------------
    // Created by the collectEvents function; moderators approve/reject.
    match /eventDrafts/{draftId} {
      allow read: if isModerator();
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow create, delete: if false;
    }

    match /eventSources/{docId} {
      allow read, write: if isModerator();
    }

    // ---------------- invites ----------------
    // invites/{code}: readable by anyone signed in who has the code (the
    // code is the secret; there's no list query that would reveal them).
    // Joining happens in the joinByInvite function, never client-side.
    match /invites/{code} {
      allow get: if true; // guests see which team invited them before signing up
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.active == true
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }

    // ---------------- Telegram linking tokens ----------------
    // One-time tokens the bot webhook exchanges for a chat link; the client
    // can only create its own and never read one back.
    match /telegramLinks/{token} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && token.size() >= 20;
      allow read, update, delete: if false;
    }

    // ---------------- precomputed stats (school leaderboard) ----------------
    match /stats/{docId} {
      allow read: if true; // aggregate school rankings only
      allow write: if false;
    }

    // ---------------- gamification (XP / levels / badges) ----------------
    // Written only by Cloud Functions (functions/src/gamification.ts) —
    // that's the whole point: XP can't be self-granted.
    match /gamification/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Your own XP ledger ("Recent" on My Profile). Queries must filter by uid.
    match /xpEvents/{eventId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // inviteCounters, sentInvites, collectorSeen: Admin SDK only — no rules
    // means no client access.

    // ---------------- reports ----------------
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'reviewed';
      allow delete: if false;
    }
  }
}