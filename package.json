{
  "name": "teamup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-teamup \"npx vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:exec --only auth,firestore,functions,storage --project demo-teamup \"bash tests/e2e/run.sh\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.56.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^10.14.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.5",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0",
    "undici": "^6.23.0"
  }
}
